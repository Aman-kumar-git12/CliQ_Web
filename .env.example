# Copy to .env and fill in. Only variables starting with VITE_ reach the browser, so never put secrets here.

# Backend API (WebsiteBackend). Also used for the Socket.IO connection.
VITE_BACKEND_URL=http://localhost:2004

# Optional: error monitoring. Paste the frontend project's DSN from sentry.io (it is public by design).
VITE_SENTRY_DSN=
